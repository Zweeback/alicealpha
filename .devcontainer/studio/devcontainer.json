{
  "name": "ALICE 3D Studio (Blender + KI-Automation)",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "features": { "ghcr.io/devcontainers/features/node:1": { "version": "22" } },
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },
  "postCreateCommand": "bash studio/setup.sh",
  "forwardPorts": [4173],
  "portsAttributes": { "4173": { "label": "ALICE Viewer" } },
  "customizations": { "vscode": { "extensions": ["GitHub.copilot", "GitHub.copilot-chat", "ms-python.python"] } }
}
