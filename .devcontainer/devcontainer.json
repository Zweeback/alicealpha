{
  "name": "Alice Alpha — Blender VRM",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "postCreateCommand": "npm ci && bash tools/setup_vrm_resources.sh",
  "forwardPorts": [
    5173,
    8787
  ],
  "portsAttributes": {
    "5173": {
      "label": "Alice Vite",
      "onAutoForward": "openPreview"
    },
    "8787": {
      "label": "Alice Realtime server",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ]
    }
  },
  "remoteEnv": {
    "NODE_ENV": "development"
  }
}
