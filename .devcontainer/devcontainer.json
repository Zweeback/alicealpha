{
  "name": "Alice Alpha + Blender VRM Studio",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "postCreateCommand": "npm ci && bash .devcontainer/install-blender-vrm.sh",
  "forwardPorts": [
    5173,
    8787
  ],
  "portsAttributes": {
    "5173": {
      "label": "Alice Vite",
      "onAutoForward": "openPreview"
    },
    "8787": {
      "label": "Alice Realtime server",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ]
    }
  },
  "remoteEnv": {
    "NODE_ENV": "development"
  }
}
