OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
PORT=8787

# Optional zero-cost local model gateway. Set these only on a machine running Ollama.
ALICE_OLLAMA_URL=http://127.0.0.1:11434
ALICE_OLLAMA_MODEL=mistral
ALICE_OLLAMA_TIMEOUT_MS=120000

# Optional hyperreal/local TTS sidecar. The bundled Chatterbox sidecar exposes POST /tts.
ALICE_TTS_URL=http://127.0.0.1:8799/tts
ALICE_TTS_PROVIDER=chatterbox
ALICE_TTS_LANGUAGE=de
ALICE_TTS_REFERENCE=/absolute/path/to/owned-or-consented-reference.wav
ALICE_TTS_TIMEOUT_MS=45000
