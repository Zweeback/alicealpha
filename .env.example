OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
PORT=8787

# Optional zero-cost local model gateway. Set these only on a machine running Ollama.
ALICE_OLLAMA_URL=http://127.0.0.1:11434
ALICE_OLLAMA_MODEL=mistral
ALICE_OLLAMA_TIMEOUT_MS=120000

# Optional hyperreal/local TTS sidecar. The bundled Chatterbox sidecar exposes POST /tts.
ALICE_TTS_URL=http://127.0.0.1:8799/tts
ALICE_TTS_PROVIDER=chatterbox
ALICE_TTS_LANGUAGE=de
ALICE_TTS_REFERENCE=/absolute/path/to/owned-or-consented-reference.wav
ALICE_TTS_TIMEOUT_MS=45000

# Provider-neutral Alice chat gateway. The default chain avoids OpenAI and uses only providers whose keys are configured.
# Keys stay server-side; unset providers are skipped automatically.
ALICE_LLM_CHAIN=gemini:gemini-2.5-flash,groq:llama-3.3-70b-versatile,openrouter:google/gemini-2.5-flash:free
ALICE_LLM_TIMEOUT_MS=8000
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ALICE_CHAT_RATE_WINDOW_MS=60000
ALICE_CHAT_RATE_MAX=30

# Optional Pixel/Android command bridge. Dry-run remains the default even when a command secret exists.
ALICE_DEVICE_COMMAND_SECRET=
ALICE_DEVICE_EXECUTION=dry-run
ALICE_DEVICE_BRIDGE_URL=
ALICE_DEVICE_BRIDGE_TOKEN=
ALICE_DEVICE_BRIDGE_TIMEOUT_MS=10000
